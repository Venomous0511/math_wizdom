<?xml version="1.0" encoding="utf-8"?>
<!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
-->
<full-backup-content>
    <!--
    By default, Auto Backup includes almost all app data.
    Customize what to include/exclude as needed.
    -->

    <!-- Include shared preferences -->
    <include domain="sharedpref" path="."/>

    <!-- Include database files -->
    <include domain="database" path="."/>

    <!-- Include internal storage files -->
    <include domain="file" path="."/>

    <!--
    Example: Exclude specific files from backup
    <exclude domain="sharedpref" path="device_specific_prefs.xml"/>
    <exclude domain="database" path="temp.db"/>
    -->

    <!--
    Example: Include only specific database
    <include domain="database" path="user_data.db"/>
    -->
</full-backup-content>